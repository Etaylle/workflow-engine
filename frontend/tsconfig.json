{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": ["$app/types", "node"],
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"moduleResolution": "bundler"
	},
	"exclude": ["build", "node_modules", "playwright-report", "test-results", "src/service-worker"]
}
