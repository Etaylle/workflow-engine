<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Process_BuildOneTask" targetNamespace="http://workflow-engine.local/bpmn" exporter="Workflow engine docs" exporterVersion="1.0">
  <bpmn:error id="Error_RunFailed" name="Run failed" errorCode="ERROR_RUNFAILED" />
  <bpmn:error id="Error_NotFixable" name="Not fixable" errorCode="ERROR_NOTFIXABLE" />
  <bpmn:collaboration id="Collab_BuildOneTask">
    <bpmn:participant id="P_Client" name="Client (anyone, no login)" />
    <bpmn:participant id="P_Engine" name="Workflow engine – development team (AI)" processRef="Process_BuildOneTask" />
    <bpmn:participant id="P_Claude" name="Claude API  (Claude Code or opencode, key of this session)" />
    <bpmn:participant id="P_GitHub" name="GitHub  (account of the project starter)" />
    <bpmn:messageFlow id="M01" name="Question when stuck" sourceRef="T_ask" targetRef="P_Client" />
    <bpmn:messageFlow id="M02" name="Answer" sourceRef="P_Client" targetRef="T_ask" />
    <bpmn:messageFlow id="M03" name="Task commit" sourceRef="T_push" targetRef="P_GitHub" />
    <bpmn:messageFlow id="M04" name="Prompts" sourceRef="P_Engine" targetRef="P_Claude" />
    <bpmn:messageFlow id="M05" name="Replies" sourceRef="P_Claude" targetRef="P_Engine" />
    <bpmn:textAnnotation id="A_ai">
      <bpmn:text>Every AI step sends its prompt to Claude through Claude Code or opencode, with the API key of this session, and gets the reply</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_BuildOneTask" name="Build one task" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="L1" name="Supervisor · Product owner">
        <bpmn:flowNodeRef>S_task</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_cont</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_sum</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2" name="Architect · Lead · UX/UI">
        <bpmn:flowNodeRef>T_define</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_dcd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_push</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L3" name="Backend · Frontend">
        <bpmn:flowNodeRef>T_build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_m2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_nf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_doc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L4" name="Tester · DevOps">
        <bpmn:flowNodeRef>T_test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_m1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ci</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ci</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L5" name="Reviewer · Auditor">
        <bpmn:flowNodeRef>T_verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ok</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_task" name="Task ready">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_plan" name="Plan the task">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_define" name="Define and plan">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="SP_dcd" name="Design, contract and data">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:task id="T_build" name="Build the change">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_test" name="Write tests">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_m1" name="">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_ci" name="Run continuous integration">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_ci" name="CI green?">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_verify" name="Verify as a team, review and audit">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_ok" name="Approved?">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_m2" name="">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_fix" name="Fix and verify">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:boundaryEvent id="B_nf" name="Not fixable" attachedToRef="T_fix">
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:errorEventDefinition id="B_nf_def" errorRef="Error_NotFixable" />
    </bpmn:boundaryEvent>
    <bpmn:task id="T_ask" name="Ask the client">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_cont" name="Continue?">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_failed" name="Run failed">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:errorEventDefinition id="E_failed_def" errorRef="Error_RunFailed" />
    </bpmn:endEvent>
    <bpmn:task id="T_accept" name="Accept">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_doc" name="Document">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="T_push" name="Merge and push">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="T_sum" name="Sum up the task">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_done" name="Task done">
      <bpmn:incoming>F23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="S_task" targetRef="T_plan" />
    <bpmn:sequenceFlow id="F02" sourceRef="T_plan" targetRef="T_define" />
    <bpmn:sequenceFlow id="F03" sourceRef="T_define" targetRef="SP_dcd" />
    <bpmn:sequenceFlow id="F04" sourceRef="SP_dcd" targetRef="T_build" />
    <bpmn:sequenceFlow id="F05" sourceRef="T_build" targetRef="T_test" />
    <bpmn:sequenceFlow id="F06" sourceRef="T_test" targetRef="G_m1" />
    <bpmn:sequenceFlow id="F07" sourceRef="G_m1" targetRef="T_ci" />
    <bpmn:sequenceFlow id="F08" sourceRef="T_ci" targetRef="G_ci" />
    <bpmn:sequenceFlow id="F09" name="Yes" sourceRef="G_ci" targetRef="T_verify" />
    <bpmn:sequenceFlow id="F10" name="No" sourceRef="G_ci" targetRef="G_m2" />
    <bpmn:sequenceFlow id="F11" sourceRef="G_m2" targetRef="T_fix" />
    <bpmn:sequenceFlow id="F12" sourceRef="T_fix" targetRef="G_m1" />
    <bpmn:sequenceFlow id="F13" sourceRef="T_verify" targetRef="G_ok" />
    <bpmn:sequenceFlow id="F14" name="No" sourceRef="G_ok" targetRef="G_m2" />
    <bpmn:sequenceFlow id="F15" name="Yes" sourceRef="G_ok" targetRef="T_accept" />
    <bpmn:sequenceFlow id="F16" sourceRef="B_nf" targetRef="T_ask" />
    <bpmn:sequenceFlow id="F17" sourceRef="T_ask" targetRef="G_cont" />
    <bpmn:sequenceFlow id="F18" name="Yes" sourceRef="G_cont" targetRef="G_m2" />
    <bpmn:sequenceFlow id="F19" name="No" sourceRef="G_cont" targetRef="E_failed" />
    <bpmn:sequenceFlow id="F20" sourceRef="T_accept" targetRef="T_doc" />
    <bpmn:sequenceFlow id="F21" sourceRef="T_doc" targetRef="T_push" />
    <bpmn:sequenceFlow id="F22" sourceRef="T_push" targetRef="T_sum" />
    <bpmn:sequenceFlow id="F23" sourceRef="T_sum" targetRef="E_done" />
    <bpmn:textAnnotation id="A_plan">
      <bpmn:text>Supervisor sets the story type and which of the 16 steps apply</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A_dcd">
      <bpmn:text>Design, contract and data: each part runs only if the task needs it</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A_fix">
      <bpmn:text>Two attempts, then the best model; still failing: the supervisor asks the client</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A_ci">
      <bpmn:text>Fresh environment when needed; automatic retry and rebuild; flaky tests are set aside</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A_push">
      <bpmn:text>Commits to the public repository of the project starter; without GitHub the work stays for the ZIP</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="X01" sourceRef="A_plan" targetRef="T_plan" />
    <bpmn:association id="X02" sourceRef="A_dcd" targetRef="SP_dcd" />
    <bpmn:association id="X03" sourceRef="A_fix" targetRef="T_fix" />
    <bpmn:association id="X04" sourceRef="A_ci" targetRef="T_ci" />
    <bpmn:association id="X05" sourceRef="A_push" targetRef="T_push" />
  </bpmn:process>
