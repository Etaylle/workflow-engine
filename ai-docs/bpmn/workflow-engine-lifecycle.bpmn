<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Process_ProjectLifecycle" targetNamespace="http://workflow-engine.local/bpmn" exporter="Workflow engine docs" exporterVersion="1.0">
  <bpmn:error id="Error_RunFailed" name="Run failed" errorCode="ERROR_RUNFAILED" />
  <bpmn:dataStore id="DS_Engine" name="Engine database" />
  <bpmn:collaboration id="Collab_ProjectLifecycle">
    <bpmn:participant id="P_Client" name="Client (anyone, no login)" />
    <bpmn:participant id="P_Engine" name="Workflow engine" processRef="Process_ProjectLifecycle" />
    <bpmn:participant id="P_Render" name="Render.com (account of the project starter)" />
    <bpmn:participant id="P_Claude" name="Claude API  (Claude Code or opencode, key of this session)" />
    <bpmn:participant id="P_GitHub" name="GitHub  (account of the project starter)" />
    <bpmn:messageFlow id="M01" name="Wish, AI choice, API key, GitHub sign-in" sourceRef="P_Client" targetRef="S_wish" />
    <bpmn:messageFlow id="M02" name="Key test" sourceRef="T_key" targetRef="P_Claude" />
    <bpmn:messageFlow id="M03" name="Test result" sourceRef="P_Claude" targetRef="T_key" />
    <bpmn:messageFlow id="M04" name="Key error" sourceRef="E_rejected" targetRef="P_Client" />
    <bpmn:messageFlow id="M05" name="Prompts" sourceRef="SP_questions" targetRef="P_Claude" />
    <bpmn:messageFlow id="M06" name="Replies" sourceRef="P_Claude" targetRef="SP_questions" />
    <bpmn:messageFlow id="M07" name="Questions" sourceRef="T_sendq" targetRef="P_Client" />
    <bpmn:messageFlow id="M08" name="Answers and stack choice" sourceRef="P_Client" targetRef="C_answers" />
    <bpmn:messageFlow id="M09" name="Prompts" sourceRef="SP_plan" targetRef="P_Claude" />
    <bpmn:messageFlow id="M10" name="Replies" sourceRef="P_Claude" targetRef="SP_plan" />
    <bpmn:messageFlow id="M11" name="Requirements and workflow" sourceRef="T_sendplan" targetRef="P_Client" />
    <bpmn:messageFlow id="M12" name="Confirmed workflow, team and steps" sourceRef="P_Client" targetRef="C_contract" />
    <bpmn:messageFlow id="M13" name="Stop request" sourceRef="P_Client" targetRef="S_stop" />
    <bpmn:messageFlow id="M14" name="Partial ZIP" sourceRef="E_partial" targetRef="P_Client" />
    <bpmn:messageFlow id="M15" name="Question when stuck" sourceRef="CA_build" targetRef="P_Client" />
    <bpmn:messageFlow id="M16" name="Answer" sourceRef="P_Client" targetRef="CA_build" />
    <bpmn:messageFlow id="M17" name="Prompts" sourceRef="CA_build" targetRef="P_Claude" />
    <bpmn:messageFlow id="M18" name="Replies" sourceRef="P_Claude" targetRef="CA_build" />
    <bpmn:messageFlow id="M19" name="Task commit" sourceRef="CA_build" targetRef="P_GitHub" />
    <bpmn:messageFlow id="M20" name="ZIP, report and links" sourceRef="E_done" targetRef="P_Client" />
    <bpmn:messageFlow id="M21" name="Deploy request" sourceRef="P_Client" targetRef="P_Render" />
    <bpmn:messageFlow id="M22" name="Repository code" sourceRef="P_GitHub" targetRef="P_Render" />
    <bpmn:textAnnotation id="A_render">
      <bpmn:text>Optional. The starter deploys from their own Render account with one link; the engine keeps no Render key.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="X06" sourceRef="A_render" targetRef="P_Render" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ProjectLifecycle" name="Run a client project" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="L_code" name="Engine (code)">
        <bpmn:flowNodeRef>S_wish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_key</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_key</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_sendq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_answers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_sendplan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_freeze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_space</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_zip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ESP_stop</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_plan" name="Planning agents (AI)">
        <bpmn:flowNodeRef>SP_questions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_plan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_dev" name="Development team (AI)">
        <bpmn:flowNodeRef>CA_build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_warn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_warn</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_wish" name="Receive wish">
      <bpmn:outgoing>F01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="S_wish_def" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="T_key" name="Check API key">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_key" name="Key valid?">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_rejected" name="Key rejected">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:messageEventDefinition id="E_rejected_def" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_create" name="Create project">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="X01">
        <bpmn:targetRef>DS_1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="DS_1" name="Engine database" dataStoreRef="DS_Engine" />
    <bpmn:subProcess id="SP_questions" name="Prepare questions">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:sendTask id="T_sendq" name="Send questions">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="C_answers" name="Receive answers">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
      <bpmn:messageEventDefinition id="C_answers_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="SP_plan" name="Plan requirements and workflow">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:sendTask id="T_sendplan" name="Send plan for review">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="C_contract" name="Receive confirmed contract">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="C_contract_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="T_freeze" name="Freeze contract">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="X02">
        <bpmn:targetRef>DS_2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="DS_2" name="Engine database" dataStoreRef="DS_Engine" />
    <bpmn:serviceTask id="T_space" name="Prepare build space">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="CA_build" name="Build each task" calledElement="Process_BuildOneTask">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="B_failed" name="Run failed" attachedToRef="CA_build">
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:errorEventDefinition id="B_failed_def" errorRef="Error_RunFailed" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_timer" name="4 h target" attachedToRef="CA_build" cancelActivity="false">
      <bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:timerEventDefinition id="B_timer_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="T_warn" name="Report overtime warning">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_warn" name="Warning shown">
      <bpmn:incoming>F20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_merge" name="">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_report" name="Assemble final report and metrics">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_zip" name="Export clean ZIP">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_done" name="Result sent">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:messageEventDefinition id="E_done_def" />
    </bpmn:endEvent>
    <bpmn:subProcess id="ESP_stop" name="Stop at any time" triggeredByEvent="true">
      <bpmn:startEvent id="S_stop" name="Receive stop request" isInterrupting="true">
        <bpmn:outgoing>F21</bpmn:outgoing>
        <bpmn:messageEventDefinition id="S_stop_def" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="T_partial" name="Export ZIP of the last checkpoint">
        <bpmn:incoming>F21</bpmn:incoming>
        <bpmn:outgoing>F22</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="E_partial" name="Partial result sent">
        <bpmn:incoming>F22</bpmn:incoming>
        <bpmn:messageEventDefinition id="E_partial_def" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="F21" sourceRef="S_stop" targetRef="T_partial" />
      <bpmn:sequenceFlow id="F22" sourceRef="T_partial" targetRef="E_partial" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="F01" sourceRef="S_wish" targetRef="T_key" />
    <bpmn:sequenceFlow id="F02" sourceRef="T_key" targetRef="G_key" />
    <bpmn:sequenceFlow id="F03" name="No" sourceRef="G_key" targetRef="E_rejected" />
    <bpmn:sequenceFlow id="F04" name="Yes" sourceRef="G_key" targetRef="T_create" />
    <bpmn:sequenceFlow id="F05" sourceRef="T_create" targetRef="SP_questions" />
    <bpmn:sequenceFlow id="F06" sourceRef="SP_questions" targetRef="T_sendq" />
    <bpmn:sequenceFlow id="F07" sourceRef="T_sendq" targetRef="C_answers" />
    <bpmn:sequenceFlow id="F08" sourceRef="C_answers" targetRef="SP_plan" />
    <bpmn:sequenceFlow id="F09" sourceRef="SP_plan" targetRef="T_sendplan" />
    <bpmn:sequenceFlow id="F10" sourceRef="T_sendplan" targetRef="C_contract" />
    <bpmn:sequenceFlow id="F11" sourceRef="C_contract" targetRef="T_freeze" />
    <bpmn:sequenceFlow id="F12" sourceRef="T_freeze" targetRef="T_space" />
    <bpmn:sequenceFlow id="F13" sourceRef="T_space" targetRef="CA_build" />
    <bpmn:sequenceFlow id="F14" sourceRef="CA_build" targetRef="G_merge" />
    <bpmn:sequenceFlow id="F15" sourceRef="B_failed" targetRef="G_merge" />
    <bpmn:sequenceFlow id="F16" sourceRef="G_merge" targetRef="T_report" />
    <bpmn:sequenceFlow id="F17" sourceRef="T_report" targetRef="T_zip" />
    <bpmn:sequenceFlow id="F18" sourceRef="T_zip" targetRef="E_done" />
    <bpmn:sequenceFlow id="F19" sourceRef="B_timer" targetRef="T_warn" />
    <bpmn:sequenceFlow id="F20" sourceRef="T_warn" targetRef="E_warn" />
    <bpmn:textAnnotation id="A_login">
      <bpmn:text>No login in the MVP: everyone sees all projects and can continue any of them</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A_key">
      <bpmn:text>API key kept in memory for this session only; entered again in each new session</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A_build">
      <bpmn:text>Runs on the engine machine in a Docker sandbox, not on Render</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A_ca">
      <bpmn:text>One instance per business task, one after another. Each finished task is pushed to a public repository of the starter (created on the first push); without GitHub: ZIP only. Up to 3 resumes.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="X03" sourceRef="A_key" targetRef="T_key" />
    <bpmn:association id="X04" sourceRef="A_build" targetRef="T_space" />
    <bpmn:association id="X05" sourceRef="A_ca" targetRef="CA_build" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_ProjectLifecycle">
    <bpmndi:BPMNPlane id="Plane_Process_ProjectLifecycle" bpmnElement="Collab_ProjectLifecycle">
      <bpmndi:BPMNShape id="P_Client_di" bpmnElement="P_Client" isHorizontal="true">
        <dc:Bounds x="40" y="70" width="2860" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_Engine_di" bpmnElement="P_Engine" isHorizontal="true">
        <dc:Bounds x="40" y="240" width="2560" height="760" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_code_di" bpmnElement="L_code" isHorizontal="true">
        <dc:Bounds x="70" y="240" width="2530" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_plan_di" bpmnElement="L_plan" isHorizontal="true">
        <dc:Bounds x="70" y="600" width="2530" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_dev_di" bpmnElement="L_dev" isHorizontal="true">
        <dc:Bounds x="70" y="760" width="2530" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_Render_di" bpmnElement="P_Render" isHorizontal="true">
        <dc:Bounds x="2640" y="500" width="260" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_Claude_di" bpmnElement="P_Claude" isHorizontal="true">
        <dc:Bounds x="40" y="1080" width="2000" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_GitHub_di" bpmnElement="P_GitHub" isHorizontal="true">
        <dc:Bounds x="2060" y="1080" width="840" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_wish_di" bpmnElement="S_wish">
        <dc:Bounds x="132.0" y="432.0" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="100" y="474" width="100" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_key_di" bpmnElement="T_key">
        <dc:Bounds x="210" y="410" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_key_di" bpmnElement="G_key" isMarkerVisible="true">
        <dc:Bounds x="385.0" y="425.0" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="370" y="480" width="80" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_rejected_di" bpmnElement="E_rejected">
        <dc:Bounds x="392.0" y="312.0" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="434" y="322" width="100" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_create_di" bpmnElement="T_create">
        <dc:Bounds x="470" y="410" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_1_di" bpmnElement="DS_1">
        <dc:Bounds x="515" y="515" width="50" height="44" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="490" y="563" width="100" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP_questions_di" bpmnElement="SP_questions" isExpanded="false">
        <dc:Bounds x="670" y="640" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_sendq_di" bpmnElement="T_sendq">
        <dc:Bounds x="850" y="410" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_answers_di" bpmnElement="C_answers">
        <dc:Bounds x="1032.0" y="432.0" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1000" y="474" width="100" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SP_plan_di" bpmnElement="SP_plan" isExpanded="false">
        <dc:Bounds x="1110" y="640" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_sendplan_di" bpmnElement="T_sendplan">
        <dc:Bounds x="1290" y="410" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="C_contract_di" bpmnElement="C_contract">
        <dc:Bounds x="1472.0" y="432.0" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1440" y="474" width="100" height="45" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_freeze_di" bpmnElement="T_freeze">
        <dc:Bounds x="1550" y="410" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_2_di" bpmnElement="DS_2">
        <dc:Bounds x="1595" y="515" width="50" height="44" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1570" y="563" width="100" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_space_di" bpmnElement="T_space">
        <dc:Bounds x="1730" y="410" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CA_build_di" bpmnElement="CA_build" isExpanded="false">
        <dc:Bounds x="1910" y="790" width="240" height="110" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_failed_di" bpmnElement="B_failed">
        <dc:Bounds x="2092.0" y="772.0" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2134" y="768" width="80" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="B_timer_di" bpmnElement="B_timer">
        <dc:Bounds x="2132.0" y="857.0" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2118" y="902" width="70" height="15" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_warn_di" bpmnElement="T_warn">
        <dc:Bounds x="2200" y="835" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_warn_di" bpmnElement="E_warn">
        <dc:Bounds x="2372.0" y="857.0" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2350" y="899" width="80" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_merge_di" bpmnElement="G_merge" isMarkerVisible="true">
        <dc:Bounds x="2205.0" y="535.0" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_report_di" bpmnElement="T_report">
        <dc:Bounds x="2160" y="410" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_zip_di" bpmnElement="T_zip">
        <dc:Bounds x="2340" y="410" width="140" height="80" />
      </bpmndi:BPMNShape>
