# Copy to .env (git-ignored) and fill in locally. Never commit .env.
# The engine stores NO user keys: users enter their Anthropic API key on screen 1 for their
# session only (ADR-033), and sign in to GitHub at the start of a project (ADR-035).
# The key below is only for the engine's own automated tests (contract tests against Claude).
# Do not export it in the shell where you start Claude Code, or Claude Code bills that key.

ANTHROPIC_API_KEY=

# GitHub OAuth app of this engine installation (device flow, scope public_repo).
# The client id is public, not a secret; each project starter signs in with their own account.
GITHUB_OAUTH_CLIENT_ID=

# Optional MCP door at /mcp (FR-AGT-13); off by default
ENGINE_MCP_ENABLED=false

POSTGRES_DB=engine
POSTGRES_USER=engine
POSTGRES_PASSWORD=change-me-locally
